# ============================================
# ORACLE CLOUD CREDENTIALS - TEMPLATE
# Copy to .env and fill in actual values
# ============================================

# ATP Instance 1 — Central / Global node (shared with SBD project, DB: bankdb)
GLOBAL_ADMIN_USER=ADMIN
GLOBAL_ADMIN_PASSWORD=your_admin_password_here
GLOBAL_SCHEMA_USER=GLOBAL_USER
GLOBAL_SCHEMA_PASSWORD=your_schema_password_here
GLOBAL_TNS_ALIAS=bankdb_high
GLOBAL_WALLET_DIR=~/.oracle/wallet
WALLET_PASSWORD=your_wallet_password_here

# ATP Instance 2 — Local nodes (Bucharest + Cluj, same instance, separate schemas, DB: localdb)
LOCAL_ADMIN_USER=ADMIN
LOCAL_ADMIN_PASSWORD=your_admin_password_here
BUCHAREST_SCHEMA_USER=BUCHAREST_USER
BUCHAREST_SCHEMA_PASSWORD=your_schema_password_here
CLUJ_SCHEMA_USER=CLUJ_USER
CLUJ_SCHEMA_PASSWORD=your_schema_password_here
LOCAL_TNS_ALIAS=localdb_high
LOCAL_WALLET_DIR=~/.oracle/wallet_local

# SQLcl path
SQLCL_PATH=/opt/homebrew/Caskroom/sqlcl/26.1.0.086.1709/sqlcl/bin

# ============================================
# SETUP:
# 1. cp .env.example .env
# 2. Fill in actual passwords
# 3. Never commit .env to git!
# ============================================
