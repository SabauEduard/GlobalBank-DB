# GlobalBank DB — Docker environment (Oracle XE 21c, 3 containers)
# Usage: cp .env.docker .env   (before running app/app.py)

DB_MODE=docker

# ── Central node (GLOBAL_USER on globalbank-central:1521) ────
GLOBAL_SCHEMA_USER=GLOBAL_USER
GLOBAL_SCHEMA_PASSWORD=SecurePass123!
GLOBAL_DSN=localhost:1521/freepdb1

# ── Bucharest node (BUCHAREST_USER on globalbank-bucharest:1522) ─
BUCHAREST_SCHEMA_USER=BUCHAREST_USER
BUCHAREST_SCHEMA_PASSWORD=SecurePass123!
BUCHAREST_DSN=localhost:1522/freepdb1

# ── Cluj node (CLUJ_USER on globalbank-cluj:1523) ────────────
CLUJ_SCHEMA_USER=CLUJ_USER
CLUJ_SCHEMA_PASSWORD=SecurePass123!
CLUJ_DSN=localhost:1523/freepdb1
